{
  "name": "@chainbloom/protocol",
  "version": "0.1.0",
  "description": "ChainBloom shared creative history protocol for Bitcoin",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "chainbloom": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "site",
    "vectors",
    "fixtures",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node ./scripts/clean.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:vectors": "tsx ./scripts/check-vectors.ts",
    "check:site": "node ./scripts/check-site.mjs",
    "build:docs": "node ./scripts/build-docs.mjs",
    "check:docs": "node ./scripts/check-docs.mjs",
    "serve:docs": "node ./scripts/serve-docs.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:vectors && npm run build:docs && npm run check:site && npm run check:docs",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "bitcoinjs-lib": "^7.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.0",
    "tsx": "^4.20.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitcoinuniverse/chainbloom.git"
  },
  "bugs": {
    "url": "https://github.com/bitcoinuniverse/chainbloom/issues"
  },
  "homepage": "https://github.com/bitcoinuniverse/chainbloom#readme",
  "keywords": [
    "bitcoin",
    "taproot",
    "utxo",
    "protocol",
    "op-return"
  ]
}
